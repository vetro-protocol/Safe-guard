# Foundry fork tests (*.e2e.ethereum.t.sol) and the hardhat fork rehearsal: an archive-capable mainnet RPC.
ETHEREUM_FORK_NODE_URL=
# Pin the fork block for the e2e tests (must predate the guard install on the Vetro curator Safe).
ETHEREUM_FORK_BLOCK_NUMBER=25570000

# Hardhat fork rehearsal (scripts/curator-guard-fork-dryrun.ts): same RPC, same block. FORK_NODE_URL is the UPSTREAM
# the in-process `hardhat` network forks from, never the node the tasks talk to.
FORK_NODE_URL=
FORK_BLOCK_NUMBER=25570000
# `--network localhost`: a dev node you run yourself, reporting chain id 31337 (anvil --chain-id 31337 --fork-url <rpc>).
LOCALHOST_NODE_URL=http://127.0.0.1:8545

# Mainnet deploy / tasks
ETHEREUM_NODE_URL=
DEPLOYER=
PRIVATE_KEY=
# Or a mnemonic: it then drives BOTH the hardhat signer and the Safe proposal signer (helpers/safe.ts).
# MNEMONIC=
# Signs Safe Transaction Service proposals (helpers/safe.ts); not PRIVATE_KEY.
DEPLOYER_PRIVATE_KEY=
SAFE_API_KEY=
ETHERSCAN_API_KEY=

# CuratorGuard tooling (tasks/curator-guard.ts, deploy/ethereum/guards/00_curator_guard.ts); all optional.
# The block the admin timelock was deployed at: every log scan (the queue, roles, approvals, revocations) starts
# there when no deployments/ record names it (also --timelock-block).
CURATOR_GUARD_TIMELOCK_BLOCK=
# Deploy script: the alias of a replacement guard, a reused timelock, the two delays in SECONDS (48 h and 3 d default).
CURATOR_GUARD_ALIAS=
CURATOR_GUARD_TIMELOCK=
CURATOR_GUARD_TIMELOCK_DELAY=
CURATOR_GUARD_ADMIN_DELAY=
# Rehearsal declaration and preflight overrides: never in a long-lived .env (the deploy script reads them on EVERY
# run, and CURATOR_GUARD_ALLOW_NO_COUNCIL / _SINGLE_PROPOSER / _SHORT_DELAY downgrade refusals on a REAL network
# too). Put them on the command line of the rehearsal instead.
# CURATOR_GUARD_FORK=1
# CURATOR_GUARD_ALLOW_KEY_OVERLAP=1
