# Foundry fork tests (*.e2e.ethereum.t.sol) and the hardhat fork rehearsal: an archive-capable mainnet RPC.
ETHEREUM_FORK_NODE_URL=
# Pin the fork block for the e2e tests (must predate the guard install on the Vetro curator Safe).
ETHEREUM_FORK_BLOCK_NUMBER=25570000

# Hardhat fork rehearsal (scripts/curator-guard-fork-dryrun.ts): same RPC, same block. FORK_NODE_URL is the UPSTREAM
# the in-process `hardhat` network forks from, never the node the tasks talk to.
FORK_NODE_URL=
FORK_BLOCK_NUMBER=25570000
# `--network localhost`: a dev node you run yourself, reporting chain id 31337 (anvil --chain-id 31337 --fork-url <rpc>).
LOCALHOST_NODE_URL=http://127.0.0.1:8545

# Mainnet deploy / tasks
ETHEREUM_NODE_URL=
DEPLOYER=
PRIVATE_KEY=
# Signs Safe Transaction Service proposals (helpers/safe.ts); not PRIVATE_KEY.
DEPLOYER_PRIVATE_KEY=
SAFE_API_KEY=
ETHERSCAN_API_KEY=
